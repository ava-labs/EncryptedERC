# ──────────────────────────────────────────────────────
# AvaDB Node — Environment Variables
# ──────────────────────────────────────────────────────

# HTTP port the NestJS server listens on
PORT=3000

# ── Blockchain ─────────────────────────────────────────
# Primary chain: AvaDB custom L1
AVADB_RPC_URL=http://127.0.0.1:9654/ext/bc/2aaCzyq19qTZLZVzDn2XxQdVwpcq945pwmrUJrdYvufJT7B4KC/rpc
AVADB_CHAIN_ID=1152111412

# Fallback: Avalanche C-Chain (for cross-chain reads)
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43114

# Private key of the replicator wallet (no 0x prefix needed)
REPLICATOR_PRIVATE_KEY=your_private_key_here

# Deployed contract addresses (fill after deployment)
AVADB_STORAGE_ADDRESS=0x0000000000000000000000000000000000000000
REGISTRAR_ADDRESS=0x0000000000000000000000000000000000000000

# Block number to start scanning events from (set to deployment block)
START_BLOCK=0

# ── RocksDB ────────────────────────────────────────────
# Directory path for RocksDB data (binary chunks / files)
ROCKSDB_PATH=./data/rocksdb

# ── Oracle DB ──────────────────────────────────────────
# Oracle connection string for structured data (JSON / metadata)
ORACLE_USER=avadb
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECTION_STRING=localhost:1521/XEPDB1

# ── Replication ────────────────────────────────────────
# Public endpoint this node advertises to the network
NODE_ENDPOINT=http://localhost:3000

# How many parallel replication jobs to run at once
REPLICATION_CONCURRENCY=5

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=debug
